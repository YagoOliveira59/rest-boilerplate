{
  "name": "rest-boilerplate",
  "version": "1.0.0",
  "description": "REST API boilerplate with Clean Architecture, Prisma, TypeScript and OpenTelemetry",
  "main": "build/index.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "tsup",
    "start": "node build/index.js",
    "dev": "tsup --watch --onSuccess=\"pnpm start\"",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "test:cov": "jest --coverage",
    "test:fast": "jest --maxWorkers=75%",
    "test:ci": "jest --maxWorkers=2 --ci",
    "test:e2e": "jest --config jest.config.e2e.js --runInBand",
    "test:e2e:cov": "jest --config jest.config.e2e.js --runInBand --coverage",
    "ts:check": "tsc --noEmit",
    "lint": "eslint --max-warnings=0 .",
    "lint:fix": "eslint --max-warnings=0 . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "knip": "knip",
    "spell:check": "cspell --no-progress '**/*.{ts,md}'",
    "spell:fix": "cspell --no-progress '**/*.{ts,md}' --fix",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "prisma:studio": "prisma studio"
  },
  "devDependencies": {
    "@babel/preset-env": "7.28.3",
    "@cspell/eslint-plugin": "9.2.1",
    "@eslint/eslintrc": "3.3.1",
    "@eslint/js": "9.37.0",
    "@faker-js/faker": "10.0.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/node": "24.5.2",
    "@types/supertest": "6.0.3",
    "@types/swagger-jsdoc": "6.0.4",
    "@types/swagger-ui-express": "4.1.8",
    "@typescript-eslint/eslint-plugin": "8.43.0",
    "babel-jest": "30.2.0",
    "cspell": "9.2.1",
    "eslint": "9.37.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-import-helpers": "2.0.1",
    "eslint-plugin-n": "17.22.0",
    "eslint-plugin-no-relative-import-paths": "1.6.1",
    "eslint-plugin-promise": "7.2.1",
    "jest": "30.2.0",
    "jest-mock-extended": "4.0.0",
    "knip": "5.64.1",
    "pino-pretty": "13.1.1",
    "prettier": "3.6.2",
    "prisma": "6.17.1",
    "supertest": "7.1.4",
    "ts-jest": "29.4.4",
    "tsup": "8.5.0",
    "tsx": "4.19.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0"
  },
  "dependencies": {
    "@google-cloud/opentelemetry-cloud-monitoring-exporter": "^0.21.0",
    "@google-cloud/opentelemetry-cloud-trace-exporter": "^3.0.0",
    "@google-cloud/pino-logging-gcp-config": "1.2.0",
    "@google-cloud/pubsub": "5.2.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.66.0",
    "@opentelemetry/context-async-hooks": "^2.2.0",
    "@opentelemetry/instrumentation": "^0.207.0",
    "@opentelemetry/resources": "^2.2.0",
    "@opentelemetry/sdk-metrics": "^2.2.0",
    "@opentelemetry/sdk-node": "^0.207.0",
    "@opentelemetry/sdk-trace-node": "^2.2.0",
    "@opentelemetry/semantic-conventions": "^1.37.0",
    "@prisma/client": "6.16.2",
    "@prisma/instrumentation": "^6.18.0",
    "cors": "2.8.5",
    "dotenv": "17.2.2",
    "express": "5.1.0",
    "pino": "9.9.5",
    "pino-http": "11.0.0",
    "redis": "5.8.2",
    "reflect-metadata": "0.2.2",
    "remeda": "2.32.0",
    "swagger-jsdoc": "6.2.8",
    "swagger-ui-express": "5.0.1",
    "tsyringe": "4.10.0",
    "uuidv7": "1.0.2",
    "zod": "4.1.12"
  },
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": "~22.17",
    "pnpm": "~10.14"
  }
}
